#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

&trackball {
    automouse-layer = <2>;
    scroll-layers = <3>;
};


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // pos0(リセット隣)  pos1=戻る   pos2=進む   pos3=左クリック
                &bt BT_NXT  &mkp MB4  &mkp MB5  &mkp LCLK
            >;
	};

    mouse_key_layer {
            bindings = <
                &trans  &mkp MB4  &mkp MB5  &mkp LCLK
        >;
    };

    auto_mouse_layer {
            // トラックボール移動中。常に同じ割り当てにする
            bindings = <
                &trans  &mkp MB4  &mkp MB5  &mkp LCLK
        >;
    };

    scroll_layer {
            // スクロール中。pos3でスクロール解除(レイヤー3 OFF)、戻る/進むは継続
            bindings = <
                &trans  &mkp MB4  &mkp MB5  &tog 3
        >;
    };
    


    };

    combos {
        compatible = "zmk,combos";

        // pos1 + pos2 = (□ - ■ ■ □)
            // 右クリック

        combo_right_click {
            bindings = <&mkp RCLK>;
            key-positions = <1 2>;
            timeout-ms = <50>;
        };

        // pos2 + pos3 = (□ - □ ■ ■)
            // スクロールのトグル(押すたびにレイヤー3=scroll_layerをON/OFF)

        combo_scroll {
            bindings = <&tog 3>;
            key-positions = <2 3>;
            timeout-ms = <50>;
        };

        // pos0 + pos3 = (■ - □ □ ■)
            // 現在の接続先のBT接続情報を消去

        combo_bt_clr {
            bindings = <&bt BT_CLR>;
            key-positions = <0 3>;
            timeout-ms = <50>;
        };


    };

};
